{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the tray popover, and the app commands it calls. App commands are only callable where a capability grants them (see build.rs), so each one the panel uses is listed here.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "notification:default",
    "opener:default",
    "updater:default",
    "allow-add-claude-directory",
    "allow-check-for-updates-now",
    "allow-clear-history-cache",
    "allow-clear-window-history",
    "allow-consume-claude-reset",
    "allow-consume-codex-reset",
    "allow-fit-window-height",
    "allow-get-account-visibility",
    "allow-get-cached-usage",
    "allow-get-notification-settings",
    "allow-get-recent-burn",
    "allow-get-start-on-login",
    "allow-get-tray-settings",
    "allow-get-update-state",
    "allow-get-usage",
    "allow-get-widget-placement",
    "allow-get-widget-settings",
    "allow-get-window-history",
    "allow-glass-enabled",
    "allow-install-update",
    "allow-list-widget-monitors",
    "allow-remove-claude-directory",
    "allow-reset-widget-position",
    "allow-set-account-hidden",
    "allow-set-claude-account-label",
    "allow-set-notification-enabled",
    "allow-set-notification-options",
    "allow-set-panel-expanded",
    "allow-set-recent-minutes",
    "allow-set-start-on-login",
    "allow-set-tray-icon-mode",
    "allow-set-update-setting",
    "allow-set-widget-account-row",
    "allow-set-widget-enabled",
    "allow-set-widget-monitor",
    "allow-set-widget-option",
    "allow-set-widget-width"
  ]
}
